<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.2</Version>
    <Company>OOXGN</Company>
    <Product>Revit MCP</Product>
    <Title>Revit MCP Setup</Title>
    <Copyright>Original work: Davud77. Modifications: Copyright 2026 OOXGN. AGPL-3.0-only.</Copyright>
    <RepositoryUrl>https://github.com/OOXGN-OOX/RevitMCP</RepositoryUrl>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>../assets/revit-mcp.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../assets/product-lockup.png" LogicalName="RevitMCP.Product.png" />
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="RevitMCP.Payload.zip" />
  </ItemGroup>
</Project>
